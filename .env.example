# Local development only. Never reuse this password for a hosted database.
POSTGRES_USER=ledgerone
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=ledgerone
DATABASE_URL=postgresql://ledgerone:local-development-only@127.0.0.1:5432/ledgerone?schema=public
# Seeds additionally require NODE_ENV=development and ALLOW_DEMO_SEED=true.
ALLOW_DEMO_SEED=false

# P1-S03: configure privately; missing/invalid configuration denies private access.
# Use this exact origin in the browser and Google callback registration.
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: openssl rand -base64 48
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact verified Google email(s), comma-separated; no wildcards or implicit domains.
AUTH_ALLOWED_EMAILS=
# Dedicated disposable database for integration/browser tests; never a personal-data DB.
TEST_DATABASE_URL=postgresql://ledgerone:local-development-only@127.0.0.1:5432/ledgerone_test?schema=public
