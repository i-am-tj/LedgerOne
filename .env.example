# Production template: copy to .env, keep private. No dummy production credentials.
# Local setup uses .env.development.example -> .env.development.local instead.
LEDGERONE_ENV=production
SUPABASE_PROJECT_REF=
# Runtime: ledgerone_app role; transaction pooler (6543) or session pooler (5432).
# Migrations: ledgerone_migrator role; direct/session connection (5432).
# Both: /postgres?schema=ledgerone&sslmode=verify-full
DATABASE_URL=
DIRECT_DATABASE_URL=
# Optional absolute path to the project's downloaded root CA certificate.
SUPABASE_DB_CA_FILE=
ALLOW_DEMO_SEED=false
# Exact future HTTPS application origin; not the Supabase project URL.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=
