generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Platform readiness marker; financial schema begins in P1-S05.
model AppMetadata {
  key   String @id
  value String

  @@map("app_metadata")
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]
  workspace     Workspace?
  auditEvents   AuditEvent[]

  @@map("auth_user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

// OAuth credentials, deliberately distinct from future financial Account.
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("auth_verification")
}

model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}

model Workspace {
  id                     String            @id @default(uuid()) @db.Uuid
  ownerId                String            @unique
  name                   String
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  owner                  User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  audit                  AuditEvent[]
  functionalCurrencyCode String            @default("INR") @db.VarChar(3)
  functionalCurrency     Currency          @relation(fields: [functionalCurrencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  ledgerAccounts         Account[]
  journals               Journal[]
  fxRates                FXRate[]
  operations             LedgerOperation[]

  @@unique([id, ownerId])
  @@unique([id, ownerId, functionalCurrencyCode])
  @@map("workspace")
}

model AuditEvent {
  id              String           @id @default(uuid()) @db.Uuid
  ownerId         String
  actorId         String
  workspaceId     String           @db.Uuid
  requestId       String           @db.Uuid
  action          String
  occurredAt      DateTime         @default(now())
  operationId     String?          @db.Uuid
  targetJournalId String?          @db.Uuid
  reason          String?          @db.VarChar(500)
  operation       LedgerOperation? @relation(fields: [operationId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  targetJournal   Journal?         @relation("FinancialAuditTarget", fields: [targetJournalId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workspace       Workspace        @relation(fields: [workspaceId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@unique([operationId, workspaceId, ownerId])
  @@index([ownerId, occurredAt, id])
  @@index([requestId])
  @@map("audit_event")
}

// S05: metadata and schema only; supported mutations arrive in S06/S07.
enum AccountClass {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum AccountKind {
  CASH
  BANK
  FIXED_DEPOSIT
  INVESTMENT
  RECEIVABLE
  OTHER_ASSET
  CREDIT_CARD
  LOAN
  OTHER_LIABILITY
  INCOME
  FX_GAIN
  EXPENSE
  FX_LOSS
  ROUNDING
  OPENING_EQUITY
  OTHER_EQUITY
}

enum PostingSide {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum JournalKind {
  GENERAL
  OPENING
  REVERSAL
}

enum LedgerOperationKind {
  POST
  OPENING
  REVERSE
  CORRECT
}

model Currency {
  code            String      @id @db.VarChar(3)
  scale           Int         @db.SmallInt
  workspaces      Workspace[]
  accounts        Account[]
  nativeRates     FXRate[]    @relation("RateNativeCurrency")
  functionalRates FXRate[]    @relation("RateFunctionalCurrency")

  @@map("currency")
}

model Account {
  holdingProfile      HoldingProfile?       @relation("HoldingAccount")
  fundedHoldings      HoldingProfile[]      @relation("HoldingFunding")
  corrections         AccountCorrection[]
  capitalSources      TransactionCapital[]  @relation("CapitalSource")
  capitalDestinations TransactionCapital[]  @relation("CapitalDestination")
  capitalInterests    TransactionCapital[]  @relation("CapitalInterest")
  outgoingMovements   TransactionMovement[] @relation("MovementSource")
  incomingMovements   TransactionMovement[] @relation("MovementDestination")
  sourceCaptures      TransactionRecord[]   @relation("CaptureAccount")
  categoryCaptures    TransactionRecord[]   @relation("CaptureCategory")
  id                  String                @id @default(uuid()) @db.Uuid
  workspaceId         String                @db.Uuid
  ownerId             String
  name                String                @db.VarChar(80)
  type                AccountClass
  kind                AccountKind
  currencyCode        String                @db.VarChar(3)
  archivedAt          DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  workspace           Workspace             @relation(fields: [workspaceId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  currency            Currency              @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  postings            Posting[]
  commands            AccountCommand[]
  events              AccountEvent[]
  opening             OpeningBalance?

  @@unique([id, workspaceId, ownerId])
  @@unique([id, workspaceId, ownerId, currencyCode])
  @@index([ownerId, workspaceId, archivedAt])
  @@map("ledger_account")
}

model LedgerOperation {
  accountCorrection AccountCorrection?
  capitals          TransactionCapital[]
  movements         TransactionMovement[]
  captures          TransactionRecord[]
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @db.Uuid
  ownerId           String
  idempotencyKey    String                @db.VarChar(128)
  requestHash       String                @db.Char(64)
  kind              LedgerOperationKind
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  workspace         Workspace             @relation(fields: [workspaceId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  journals          Journal[]
  financialAudit    AuditEvent?

  @@unique([id, workspaceId, ownerId])
  @@unique([workspaceId, ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@map("ledger_operation")
}

model Journal {
  correctionOriginals    AccountCorrection[] @relation("CorrectionOriginal")
  correctionRoots        AccountCorrection[] @relation("CorrectionRoot")
  id                     String              @id @default(uuid()) @db.Uuid
  workspaceId            String              @db.Uuid
  ownerId                String
  functionalCurrencyCode String              @default("INR") @db.VarChar(3)
  status                 JournalStatus       @default(DRAFT)
  kind                   JournalKind         @default(GENERAL)
  description            String              @default("") @db.VarChar(500)
  effectiveAt            DateTime            @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  postedAt               DateTime?           @db.Timestamptz(3)
  revision               Int                 @default(0)
  operationId            String?             @db.Uuid
  reversesJournalId      String?             @db.Uuid
  workspace              Workspace           @relation(fields: [workspaceId, ownerId, functionalCurrencyCode], references: [id, ownerId, functionalCurrencyCode], onDelete: Restrict, onUpdate: Restrict)
  operation              LedgerOperation?    @relation(fields: [operationId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  reverses               Journal?            @relation("JournalReversal", fields: [reversesJournalId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  reversal               Journal?            @relation("JournalReversal")
  postings               Posting[]
  opening                OpeningBalance?
  targetAudits           AuditEvent[]        @relation("FinancialAuditTarget")

  @@unique([id, workspaceId, ownerId])
  @@unique([id, workspaceId, ownerId, functionalCurrencyCode])
  @@unique([reversesJournalId, workspaceId, ownerId])
  @@index([ownerId, workspaceId, status, effectiveAt, id])
  @@index([operationId, workspaceId, ownerId])
  @@map("journal")
}

model FXRate {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @db.Uuid
  ownerId                String
  nativeCurrencyCode     String    @db.VarChar(3)
  functionalCurrencyCode String    @default("INR") @db.VarChar(3)
  quote                  Decimal   @db.Decimal(38, 18)
  effectiveAt            DateTime  @db.Timestamptz(3)
  source                 String    @db.VarChar(160)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  workspace              Workspace @relation(fields: [workspaceId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  nativeCurrency         Currency  @relation("RateNativeCurrency", fields: [nativeCurrencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  functionalCurrency     Currency  @relation("RateFunctionalCurrency", fields: [functionalCurrencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  postings               Posting[]

  @@unique([id, workspaceId, ownerId, nativeCurrencyCode, functionalCurrencyCode], map: "fx_rate_owned_currency_key")
  @@index([ownerId, workspaceId, nativeCurrencyCode, effectiveAt])
  @@map("fx_rate")
}

model Posting {
  id                     String      @id @default(uuid()) @db.Uuid
  journalId              String      @db.Uuid
  workspaceId            String      @db.Uuid
  ownerId                String
  accountId              String      @db.Uuid
  currencyCode           String      @db.VarChar(3)
  functionalCurrencyCode String      @default("INR") @db.VarChar(3)
  side                   PostingSide
  nativeMinor            BigInt
  functionalMinor        BigInt
  fxRateId               String?     @db.Uuid
  journal                Journal     @relation(fields: [journalId, workspaceId, ownerId, functionalCurrencyCode], references: [id, workspaceId, ownerId, functionalCurrencyCode], onDelete: Restrict, onUpdate: Restrict)
  account                Account     @relation(fields: [accountId, workspaceId, ownerId, currencyCode], references: [id, workspaceId, ownerId, currencyCode], onDelete: Restrict, onUpdate: Restrict)
  fxRate                 FXRate?     @relation(fields: [fxRateId, workspaceId, ownerId, currencyCode, functionalCurrencyCode], references: [id, workspaceId, ownerId, nativeCurrencyCode, functionalCurrencyCode], onDelete: Restrict, onUpdate: Restrict)

  @@index([journalId, workspaceId, ownerId])
  @@index([ownerId, accountId, journalId])
  @@map("posting")
}

model OpeningBalance {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  ownerId     String
  accountId   String   @db.Uuid
  journalId   String   @db.Uuid
  source      String   @db.VarChar(160)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  account     Account  @relation(fields: [accountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  journal     Journal  @relation(fields: [journalId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([accountId, workspaceId, ownerId])
  @@unique([journalId, workspaceId, ownerId])
  @@map("opening_balance")
}

model AccountCommand {
  id             String         @id @db.Uuid
  workspaceId    String         @db.Uuid
  ownerId        String
  accountId      String         @db.Uuid
  idempotencyKey String         @db.VarChar(128)
  requestHash    String         @db.Char(64)
  result         Json
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  account        Account        @relation(fields: [accountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  events         AccountEvent[]

  @@unique([id, workspaceId, ownerId])
  @@unique([workspaceId, ownerId, idempotencyKey])
  @@map("account_command")
}

model AccountEvent {
  id          String         @id @db.Uuid
  requestId   String         @db.Uuid
  commandId   String         @unique @db.Uuid
  workspaceId String         @db.Uuid
  ownerId     String
  accountId   String         @db.Uuid
  actorId     String
  action      String         @db.VarChar(32)
  data        Json
  effectiveAt DateTime       @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  command     AccountCommand @relation(fields: [commandId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  account     Account        @relation(fields: [accountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerId, accountId, createdAt])
  @@map("account_event")
}

model TransactionRecord {
  operationId       String          @id @db.Uuid
  workspaceId       String          @db.Uuid
  ownerId           String
  kind              String          @db.VarChar(12)
  accountId         String          @db.Uuid
  categoryAccountId String          @db.Uuid
  accountName       String          @db.VarChar(80)
  categoryName      String          @db.VarChar(80)
  amountMinor       BigInt
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  operation         LedgerOperation @relation(fields: [operationId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  account           Account         @relation("CaptureAccount", fields: [accountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  category          Account         @relation("CaptureCategory", fields: [categoryAccountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerId, workspaceId, createdAt])
  @@map("transaction_record")
}

model TransactionMovement {
  operationId            String          @id @db.Uuid
  workspaceId            String          @db.Uuid
  ownerId                String
  kind                   String          @db.VarChar(20)
  sourceAccountId        String          @db.Uuid
  destinationAccountId   String          @db.Uuid
  sourceAccountName      String          @db.VarChar(80)
  destinationAccountName String          @db.VarChar(80)
  amountMinor            BigInt
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  operation              LedgerOperation @relation(fields: [operationId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  source                 Account         @relation("MovementSource", fields: [sourceAccountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  destination            Account         @relation("MovementDestination", fields: [destinationAccountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict, map: "movement_destination_scope_fkey")

  @@index([ownerId, workspaceId, createdAt])
  @@map("transaction_movement")
}

model TransactionCapital {
  operationId            String          @id @db.Uuid
  workspaceId            String          @db.Uuid
  ownerId                String
  kind                   String          @db.VarChar(20)
  sourceAccountId        String          @db.Uuid
  destinationAccountId   String          @db.Uuid
  sourceAccountName      String          @db.VarChar(80)
  destinationAccountName String          @db.VarChar(80)
  interestAccountId      String?         @db.Uuid
  interestAccountName    String?         @db.VarChar(80)
  principalMinor         BigInt
  interestMinor          BigInt
  amountMinor            BigInt
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  operation              LedgerOperation @relation(fields: [operationId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict, map: "capital_operation_scope_fkey")
  source                 Account         @relation("CapitalSource", fields: [sourceAccountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict, map: "capital_source_scope_fkey")
  destination            Account         @relation("CapitalDestination", fields: [destinationAccountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict, map: "capital_destination_scope_fkey")
  interestAccount        Account?        @relation("CapitalInterest", fields: [interestAccountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict, map: "capital_interest_scope_fkey")

  @@index([ownerId, workspaceId, createdAt])
  @@map("transaction_capital")
}

model AccountCorrection {
  operationId            String          @id @db.Uuid
  workspaceId            String          @db.Uuid
  ownerId                String
  accountId              String          @db.Uuid
  originalJournalId      String          @db.Uuid
  rootJournalId          String          @db.Uuid
  reversalJournalId      String?         @db.Uuid
  replacementJournalId   String?         @db.Uuid
  mode                   String          @db.VarChar(8)
  amountMinor            Decimal         @db.Decimal(18, 0)
  commandHash            String          @db.Char(64)
  effectiveAt            DateTime        @db.Timestamptz(3)
  replacementEffectiveAt DateTime        @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  operation              LedgerOperation @relation(fields: [operationId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  account                Account         @relation(fields: [accountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  original               Journal         @relation("CorrectionOriginal", fields: [originalJournalId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  root                   Journal         @relation("CorrectionRoot", fields: [rootJournalId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, workspaceId, ownerId])
  @@unique([originalJournalId, workspaceId, ownerId])
  @@index([accountId, workspaceId, ownerId])
  @@map("account_correction")
}

// Wealth: descriptive holding metadata; balances stay derived from postings.
model HoldingProfile {
  accountId        String   @id @db.Uuid
  workspaceId      String   @db.Uuid
  ownerId          String
  category         String   @db.VarChar(32)
  institution      String?  @db.VarChar(120)
  institutionKey   String?  @db.VarChar(40)
  platform         String?  @db.VarChar(120)
  platformKey      String?  @db.VarChar(40)
  fundingAccountId String?  @db.Uuid
  details          Json     @default("{}")
  secretCipher     String?
  notes            String?  @db.VarChar(2000)
  revision         Int      @default(1)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  account          Account  @relation("HoldingAccount", fields: [accountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict)
  funding          Account? @relation("HoldingFunding", fields: [fundingAccountId, workspaceId, ownerId], references: [id, workspaceId, ownerId], onDelete: Restrict, onUpdate: Restrict, map: "holding_profile_funding_scope_fkey")

  @@unique([accountId, workspaceId, ownerId])
  @@index([ownerId, workspaceId, category])
  @@index([fundingAccountId])
  @@map("holding_profile")
}
