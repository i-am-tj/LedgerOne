# Dummy values for local Docker only. Never use these for hosted infrastructure.
LEDGERONE_ENV=development
POSTGRES_USER=ledgerone
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=ledgerone
DATABASE_URL=postgresql://ledgerone:local-development-only@127.0.0.1:5432/ledgerone?schema=public
DIRECT_DATABASE_URL=postgresql://ledgerone:local-development-only@127.0.0.1:5432/ledgerone?schema=public
TEST_DATABASE_URL=postgresql://ledgerone:local-development-only@127.0.0.1:5432/ledgerone_test?schema=public
SUPABASE_PROJECT_REF=
SUPABASE_DB_CA_FILE=
ALLOW_DEMO_SEED=false
BETTER_AUTH_URL=http://localhost:3000
# Public preview works without OAuth. Add private local Google/GitHub values to test login.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=
