{
  "name": "ledgerone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate-db.ts development",
    "db:seed": "prisma db seed",
    "db:up": "docker compose --env-file .env.development.local up -d --wait",
    "db:stop": "docker compose --env-file .env.development.local stop",
    "verify": "./scripts/verify.sh",
    "verify:pipeline": "./scripts/verify.sh --pipeline-only",
    "verify:smoke": "./scripts/verify.sh --smoke-only",
    "db:migrate:test": "tsx scripts/migrate-test-db.ts",
    "test:e2e": "tsx scripts/run-browser-tests.ts",
    "test:e2e:ui": "tsx scripts/run-browser-tests.ts --ui",
    "db:migrate:production": "tsx scripts/migrate-db.ts production",
    "start:local": "tsx scripts/start-local.ts",
    "test:schema": "tsx scripts/rehearse-production-schema.ts",
    "ledger:attest": "tsx scripts/verify-ledger-invariants.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.20",
    "@hookform/resolvers": "7.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "better-auth": "1.7.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
